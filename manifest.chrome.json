{
  "manifest_version": 3,
  "name": "Mermaid JSDoc Viewer for GitHub",
  "version": "1.0.0",
  "description": "Open and preview Mermaid diagrams found in JSDoc comments while browsing source files on GitHub.",
  "homepage_url": "https://github.com/g-ongenae/mermaid-jsdoc-viewer-for-github",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["pako_deflate.min.js", "content_script.js"],
      "css": ["viewer.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mermaid JSDoc Viewer for GitHub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
